      <firstStatus>
          <!-- Propert Binding -->
         <!-- <ObjectStatus id="objl5" text="{oModel>Status}" state="{path:'oModel>Status', formatter:'.f.formatStatus'}" inverted ="true"></ObjectStatus>  -->
